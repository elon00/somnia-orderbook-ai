{
  "mcpServers": {
    "somnia-orderbook-ai": {
      "command": "cargo",
      "args": [
        "run",
        "--release",
        "--quiet"
      ],
      "env": {
        "RUST_LOG": "info",
        "HACKATHON_TRACK": "Somnia Network",
        "PROJECT_TICKER": "SOMCLOB"
      },
      "tools": [
        {
          "name": "verify_somclob_invariants",
          "description": "Verifies deterministic invariants for Somnia Orderbook AI on Somnia Network."
        },
        {
          "name": "execute_somclob_action",
          "description": "Executes authenticated DeFi state transition."
        }
      ]
    }
  }
}